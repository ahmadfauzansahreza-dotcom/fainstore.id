// FAIN STORE — Prisma schema
// Uang disimpan sebagai Int dalam satuan Rupiah penuh (bukan float) untuk menghindari galat pembulatan.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum ProductType {
  GAME_ACCOUNT
  TOPUP
}

enum StockStatus {
  AVAILABLE
  RESERVED
  SOLD
  DISABLED
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  CAPTURE
  PAID
  EXPIRE
  CANCEL
  DENY
  REFUND
  PARTIAL_REFUND
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  phone         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist[]
  notifications Notification[]
  couponUsages  CouponUsage[]
  adminLogs     AdminLog[]

  @@index([email])
}

model Game {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  categories Category[]
  products   Product[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id])
  createdAt DateTime @default(now())

  products Product[]

  @@index([gameId])
}

model Product {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  type             ProductType
  gameId           String
  game             Game        @relation(fields: [gameId], references: [id])
  categoryId       String?
  category         Category?   @relation(fields: [categoryId], references: [id])
  description      String?
  specifications   Json? // level, rank, evo gun, heroes, skins, dll — hanya field yang diisi admin
  priceIdr         Int // harga jual, satuan Rupiah penuh
  originalPriceIdr Int?
  discountPct      Int?
  stockQty         Int         @default(0) // untuk TOPUP; GAME_ACCOUNT dihitung dari GameAccount
  isFeatured       Boolean     @default(false)
  isBestSeller     Boolean     @default(false)
  isFlashSale      Boolean     @default(false)
  status           Boolean     @default(true)
  soldCount        Int         @default(0)
  warranty         String?
  isDemo           Boolean     @default(false) // wajib true untuk data demo/dev
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  images       ProductImage[]
  gameAccounts GameAccount[]
  orderItems   OrderItem[]
  reviews      Review[]
  wishlist     Wishlist[]

  @@index([gameId, categoryId])
  @@index([slug])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)
}

// Setiap baris = satu akun game unik yang bisa dijual.
model GameAccount {
  id               String      @id @default(cuid())
  productId        String
  product          Product     @relation(fields: [productId], references: [id])
  loginMethod      String?
  usernameEmailEnc String // dienkripsi di application layer sebelum disimpan
  passwordEnc      String // dienkripsi di application layer sebelum disimpan
  recoveryDataEnc  String?
  status           StockStatus @default(AVAILABLE)
  reservedUntil    DateTime? // batas waktu reservasi saat checkout berjalan
  orderItemId      String?     @unique
  orderItem        OrderItem?  @relation(fields: [orderItemId], references: [id])
  soldAt           DateTime?
  createdAt        DateTime    @default(now())

  @@index([productId, status])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique // nomor order yang ditampilkan ke customer
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  customerName   String
  customerEmail  String
  customerPhone  String
  notes          String?
  subtotalIdr    Int
  discountIdr    Int         @default(0)
  feeIdr         Int         @default(0)
  totalIdr       Int
  couponId       String?
  coupon         Coupon?     @relation(fields: [couponId], references: [id])
  status         OrderStatus @default(PENDING)
  deliveryStatus String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items      OrderItem[]
  payment    Payment?
  invoice    Invoice?
  topUpOrder TopUpOrder?

  @@index([userId])
  @@index([orderNumber])
}

model OrderItem {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id])
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  quantity    Int          @default(1)
  priceIdr    Int // harga per item saat transaksi (snapshot, hitung ulang server-side)
  gameAccount GameAccount?

  @@index([orderId])
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String        @unique
  order            Order         @relation(fields: [orderId], references: [id])
  providerOrderId  String        @unique @map("midtransOrderId")
  paymentReference String?       @map("snapToken")
  method           String?
  status           PaymentStatus @default(PENDING)
  grossAmountIdr   Int
  rawResponse      Json?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  events PaymentEvent[]
}

// Menyimpan setiap notifikasi webhook payment provider untuk idempotensi & audit.
model PaymentEvent {
  id                    String   @id @default(cuid())
  paymentId             String
  payment               Payment  @relation(fields: [paymentId], references: [id])
  providerTransactionId String   @unique @map("midtransTransactionId")
  eventType             String
  statusCode            String?
  signatureValid        Boolean
  rawPayload            Json
  processedAt           DateTime @default(now())

  @@index([paymentId])
}

model TopUpOrder {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  gameUid     String
  serverId    String?
  nickname    String?
  providerRef String? // referensi dari TopUpProvider bila terhubung
  status      String   @default("PAID") // PAID -> PROCESSING -> COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  discountType   DiscountType
  percentage     Int?
  fixedAmountIdr Int?
  minPurchaseIdr Int?
  maxDiscountIdr Int?
  startDate      DateTime
  endDate        DateTime
  usageLimit     Int?
  perUserLimit   Int?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  orders Order[]
  usages CouponUsage[]
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  coupon   Coupon   @relation(fields: [couponId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  usedAt   DateTime @default(now())

  @@index([couponId, userId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  rating     Int
  comment    String?
  imageUrl   String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([productId, userId]) // 1 review per produk per user, hanya yang sudah membeli
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Invoice {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  invoiceNumber String   @unique
  issuedAt      DateTime @default(now())
}

model AdminLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  detail    Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  position  Int       @default(0)
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
}

model Settings {
  id                  String  @id @default(cuid())
  storeName           String  @default("FAIN STORE")
  storeDescription    String?
  whatsappNumber      String?
  email               String?
  instagram           String?
  tiktok              String?
  discord             String?
  maintenanceMode     Boolean @default(false)
  warrantyPolicy      String?
  termsContent        String?
  privacyContent      String?
  refundPolicyContent String?
}

model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  content      String
  rating       Int
  avatarUrl    String?
  isApproved   Boolean  @default(false)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
}
