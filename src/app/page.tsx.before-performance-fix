"use client";
import { Footer } from "@/components/layout/Footer";
import HeroBannerCarousel from "@/components/HeroBannerCarousel";
import { Header } from "@/components/layout/Header";
import { MobileBottomNav } from "@/components/layout/MobileBottomNav";

import { useEffect, useMemo, useState } from "react";
import Link from "next/link";
import { motion } from "framer-motion";
import {
  ArrowRight,
  ChevronRight,
  Gamepad2,
  ShieldCheck,
  Zap,
  CreditCard,
  Search,
  Sparkles,
  ShoppingCart,
} from "lucide-react";

interface Product {
  id: string;
  slug: string;
  name: string;
  priceIdr: number;
  originalPriceIdr?: number | null;
  discountPct?: number | null;
  stockQty: number;
  soldCount: number;
  images?: {
    url: string;
  }[];
  game?: {
    name: string;
    slug: string;
  };
  category?: {
    id?: string;
    name: string;
    slug: string;
  } | null;
  type?: "GAME_ACCOUNT" | "TOPUP";
}

interface Game {
  id?: string;
  name: string;
  slug: string;
  imageUrl?: string | null;
  isActive?: boolean;
  categories?: {
    id?: string;
    name: string;
    slug: string;
  }[];
}

const formatRupiah = (value: number) =>
  new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0,
  }).format(value);

export default function HomePage() {
  const [products, setProducts] = useState<Product[]>([]);
  const [games, setGames] = useState<Game[]>([]);
  const [loading, setLoading] = useState(true);
  const [selectedProductCategory, setSelectedProductCategory] = useState<"TOPUP" | "VOUCHER" | "LIVE_APP">("TOPUP");
  const [visibleCount, setVisibleCount] = useState(12);

  const handleShowMore = () => {
    setVisibleCount((current) => Math.min(current + 12, games.length));
  };

  const handleShowLess = () => {
    setVisibleCount(12);
  };

  const [canonicalMap, setCanonicalMap] = useState<Record<string, string | null>>({});
  const [catalogTab, setCatalogTab] = useState<"topup" | "voucher" | "live">("topup");


  useEffect(() => {
    let cancelled = false;

    const loadGames = async () => {
      try {
        const gamesRes = await fetch("/api/games", {
          cache: "no-store",
        });

        if (!gamesRes.ok) {
          throw new Error(`Games API ${gamesRes.status}`);
        }

        const gamesData = await gamesRes.json();

        if (!cancelled) {
          setGames(gamesData.items ?? []);
        }
      } catch (error) {
        console.error("Games API error:", error);

        if (!cancelled) {
          setGames([]);
        }
      }
    };

    const loadProducts = async () => {
      try {
        const res = await fetch("/api/products?pageSize=100", {
          cache: "no-store",
        });

        if (!res.ok) {
          throw new Error(`Products API ${res.status}`);
        }

        const data = await res.json();

        if (!cancelled) {
          setProducts(data.items ?? []);
        }
      } catch (error) {
        console.error("Products API error:", error);

        if (!cancelled) {
          setProducts([]);
        }
      }
    };

    const loadCanonicalMap = async () => {
      try {
        const canonicalRes = await fetch("/canonical-game-map.json", {
          cache: "no-store",
        });

        if (canonicalRes.ok) {
          const canonicalData = await canonicalRes.json();

          if (!cancelled) {
            setCanonicalMap(canonicalData.aliases ?? {});
          }
        }
      } catch (error) {
        console.warn("Canonical game map unavailable:", error);

        if (!cancelled) {
          setCanonicalMap({});
        }
      }
    };

    // Semua sumber data berjalan independen.
    // Kegagalan Products tidak boleh menghilangkan Games.
    loadGames();
    loadProducts();
    loadCanonicalMap();

    // Jangan menahan homepage sampai Products selesai.
    setLoading(false);

    return () => {
      cancelled = true;
    };
  }, []);


  const categoryMatchers: Record<
    "topup" | "voucher" | "live",
    (categoryName: string, categorySlug: string) => boolean
  > = {
    topup: (name, slug) =>
      name.toLowerCase().includes("top up") ||
      name.toLowerCase().includes("topup") ||
      slug.toLowerCase().includes("top-up") ||
      slug.toLowerCase().includes("topup"),

    voucher: (name, slug) =>
      name.toLowerCase().includes("voucher") ||
      slug.toLowerCase().includes("voucher"),

    live: (name, slug) => {
      const premiumSlugs = [
        "canva-pro",
        "bstation-premium",
        "alight-motion",
        "capcut-pro",
        "youtube-premium",
        "iqiyi-premium",
        "vidio-premier",
        "vision-plus",
        "viu-premium",
        "wetv-premium",
        "gemini",
        "amazon-prime-video",
      ];

      return premiumSlugs.includes(slug.toLowerCase());
    },
  };

  const catalogGames = useMemo(() => {
    const premiumSlugs = new Set([
      "canva-pro",
      "bstation-premium",
      "alight-motion",
      "capcut-pro",
      "youtube-premium",
      "iqiyi-premium",
      "vidio-premier",
      "vision-plus",
      "viu-premium",
      "wetv-premium",
      "gemini",
      "amazon-prime-video",
    ]);

    const grouped = new Map<string, Game>();

    for (const game of games) {
      if (game.isActive === false) continue;

      const canonicalSlug =
        canonicalMap[game.slug] ?? game.slug;

      const existing = grouped.get(canonicalSlug);

      if (!existing || game.slug === canonicalSlug) {
        grouped.set(canonicalSlug, game);
      }
    }

    const allGames = Array.from(grouped.values());

    if (catalogTab === "live") {
      return allGames.filter((game) =>
        premiumSlugs.has(game.slug.toLowerCase())
      );
    }

    if (catalogTab === "voucher") {
      return allGames.filter((game) => {
        const slug = game.slug.toLowerCase();
        const categories = game.categories ?? [];

        return (
          slug.includes("voucher") ||
          categories.some((category) => {
            const name = (category.name ?? "").toLowerCase();
            const categorySlug = (category.slug ?? "").toLowerCase();

            return (
              name.includes("voucher") ||
              categorySlug.includes("voucher")
            );
          })
        );
      });
    }

    return allGames.filter((game) => {
      const categories = game.categories ?? [];

      // Normal Top Up classification.
      // Game yang memang memiliki kategori Top Up masuk ke katalog.
      return categories.some((category) => {
        const name = (category.name ?? "").toLowerCase();
        const slug = (category.slug ?? "").toLowerCase();

        return (
          name === "top up" ||
          name.includes("top up") ||
          name.includes("topup") ||
          slug.includes("top-up") ||
          slug.includes("topup")
        );
      });
    });
  }, [games, canonicalMap, catalogTab]);

  const visibleGames = games.slice(0, visibleCount);


  const popularGames = [
    "free-fire",
    "mobile-legends-b",
    "roblox-voucher",
    "pubg-mobile-id",
    "genshin-impact",
    "valorant",
  ]
    .map((slug) => {
      const game = games.find(
        (item) => item.slug.toLowerCase() === slug
      );

      return game
        ? {
            ...game,
            image: game.imageUrl || "/placeholder-product.jpg",
          }
        : null;
    })
    .filter(
      (
        game
      ): game is Game & {
        image: string;
      } => Boolean(game)
    );

  return (
    <>
      <Header />

      <main className="relative min-h-screen overflow-hidden bg-[#050505] text-white [background-image:linear-gradient(rgba(255,255,255,0.018)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.018)_1px,transparent_1px),linear-gradient(135deg,#050505_0%,#0a0a0a_45%,#050505_100%)] [background-size:48px_48px,48px_48px,100%_100%]">
      <div
        aria-hidden="true"
        className="pointer-events-none absolute inset-0 -z-0 opacity-[0.28]"
        style={{
          backgroundImage:
            "repeating-linear-gradient(135deg, rgba(255,255,255,0.018) 0px, rgba(255,255,255,0.018) 1px, transparent 1px, transparent 6px), repeating-linear-gradient(45deg, rgba(0,0,0,0.35) 0px, rgba(0,0,0,0.35) 1px, transparent 1px, transparent 6px)",
        }}
      />

      <div
        aria-hidden="true"
        className="pointer-events-none absolute left-[-15%] top-[18%] -z-0 h-[420px] w-[420px] rounded-full bg-[#d6a84a]/[0.035] blur-[140px]"
      />

      <div
        aria-hidden="true"
        className="pointer-events-none absolute right-[-12%] top-[42%] -z-0 h-[520px] w-[520px] rounded-full bg-[#d6a84a]/[0.025] blur-[160px]"
      />


      {/* =========================================================
          HERO
      ========================================================= */}
        {/* HERO BANNER */}
        {/* =========================================================
            HERO BANNER CAROUSEL
        ========================================================= */}
        <section className="relative border-b border-white/10">
          <div className="mx-auto max-w-7xl px-3 pt-3 pb-5 sm:px-6 sm:pt-6 sm:pb-8 lg:px-8">
            <div className="relative block w-full">
              <div className="relative overflow-hidden rounded-3xl border border-white/10 bg-black shadow-2xl">
                <HeroBannerCarousel />
              </div>
            </div>
          </div>
        </section>

        {/* =========================================================
          POPULAR GAMES — ITSUGAMARKET STYLE
        ========================================================= */}
        <section className="mx-auto max-w-7xl px-3 pt-7 pb-8 sm:px-6 sm:pt-8 sm:pb-10 lg:px-8">
          <div className="mb-5">
            <div className="flex items-center gap-2">
              <span className="text-xl">🔥</span>
              <h2 className="text-xl font-black sm:text-2xl">
                POPULER SEKARANG!
              </h2>
            </div>

            <p className="mt-2 text-xs text-white/50 sm:text-sm">
              Berikut adalah beberapa game yang paling populer saat ini.
            </p>
          </div>

            {popularGames.length > 0 ? (
              <div className="grid grid-cols-2 gap-2.5 sm:grid-cols-3 sm:gap-3 lg:grid-cols-3">
                {popularGames.map((game, index) => {
                  const gameImage =
                    game.imageUrl || "/placeholder-product.jpg";

                  return (
                    <motion.div
                      key={game.slug}
                      initial={{ opacity: 0, y: 14, scale: 0.97 }}
                      animate={{ opacity: 1, y: 0, scale: 1 }}
                      transition={{
                        duration: 0.32,
                        delay: Math.min(index * 0.018, 0.12),
                        ease: [0.22, 1, 0.36, 1],
                      }}
                    >
                      <Link
                        href={`/game/${game.slug}`}
                        className="group relative flex min-h-[72px] items-center gap-3 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.025] px-3 py-3 transition-all duration-300 hover:-translate-y-1 hover:border-[#d6a84a]/40 hover:bg-[#d6a84a]/[0.06] hover:shadow-[0_12px_35px_rgba(0,0,0,0.28)] active:scale-[0.97]"
                      >
                        <div className="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#d6a84a]/0 via-[#d6a84a]/0 to-[#d6a84a]/[0.06] opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

                        <div className="relative h-12 w-12 shrink-0 overflow-hidden rounded-xl border border-white/10 bg-white/[0.04]">
                          <img
                            src={gameImage}
                            alt={game.name}
                            className="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
                          />
                          <div className="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
                        </div>

                        <div className="relative min-w-0 flex-1">
                          <p className="truncate text-xs font-bold text-white transition-colors duration-200 group-hover:text-[#d6a84a]">
                            {game.name}
                          </p>
                          <p className="mt-1 text-[9px] text-white/40 transition-colors duration-200 group-hover:text-white/55">
                            FAIN STORE
                          </p>
                        </div>

                        <ChevronRight className="relative h-4 w-4 shrink-0 text-white/20 transition-all duration-300 group-hover:translate-x-0.5 group-hover:text-[#d6a84a]" />
                      </Link>
                    </motion.div>
                  );
                })}
              </div>
            ) : (
              <div className="rounded-2xl border border-white/10 bg-white/[0.03] p-8 text-center text-sm text-white/50">
                Game populer belum tersedia.
              </div>
            )}
        </section>



      {/* =========================================================
          GAME CATALOG — ITSUGAMARKET STYLE
      ========================================================= */}
      <section className="mx-auto max-w-7xl px-4 pt-2 pb-10 sm:px-6 lg:px-8">

        <div className="mb-5">
          <div className="flex items-center gap-2">
            <span className="text-xl">🎮</span>

            <h2 className="text-xl font-black sm:text-2xl">
              PILIH GAME
            </h2>
          </div>

          <p className="mt-2 text-xs text-white/50 sm:text-sm">
            Pilih layanan game yang ingin kamu gunakan.
          </p>
        </div>

        {/* CATEGORY TABS */}
        <div className="mb-6 grid grid-cols-3 gap-2">
          {[
            { id: "topup", label: "Top Up" },
            { id: "voucher", label: "Voucher" },
            { id: "live", label: "App Premium" },
          ].map((tab) => {
            const active = catalogTab === tab.id;

            return (
              <button
                key={tab.id}
                type="button"
                onClick={() => {
                  setCatalogTab(
                    tab.id as "topup" | "voucher" | "live"
                  );
                  setVisibleCount(12);
                }}
                className={[
                  "h-11 rounded-xl border text-sm font-bold transition",
                  active
                    ? "border-[#d6a84a] bg-[#d6a84a] text-[#171006]"
                    : "border-white/10 bg-white/[0.04] text-white/60 hover:border-white/20 hover:text-white",
                ].join(" ")}
              >
                {tab.label}
              </button>
            );
          })}
        </div>

        {(() => {
          const matchesCategory = (game: Game) => {
            const categories = game.categories ?? [];

            return categories.some((category) => {
              const name = category.name.toLowerCase();
              const slug = category.slug.toLowerCase();

              if (catalogTab === "voucher") {
                return (
                  name.includes("voucher") ||
                  slug.includes("voucher")
                );
              }

              if (catalogTab === "live") {
                return (
                  name.includes("live") ||
                  name.includes("service") ||
                  name.includes("app") ||
                  slug.includes("live") ||
                  slug.includes("service") ||
                  slug.includes("app")
                );
              }

              return (
                name.includes("top up") ||
                name.includes("topup") ||
                slug.includes("top-up") ||
                slug.includes("topup")
              );
            });
          };


          return catalogGames.length > 0 ? (
            <>
              <div className="grid grid-cols-3 gap-2.5 sm:gap-3">
                {visibleGames.map((game) => (
                  <motion.div
                    key={game.slug}
                    initial={{
                      opacity: 0,
                      y: 14,
                      scale: 0.985,
                    }}
                    animate={{
                      opacity: 1,
                      y: 0,
                      scale: 1,
                    }}
                    transition={{
                      duration: 0.42,
                      delay: Math.min(visibleGames.indexOf(game) * 0.035, 0.35),
                      ease: [0.22, 1, 0.36, 1],
                    }}
                  >
                    <Link
                      href={`/game/${game.slug}`}
                      prefetch={true}
                      className="group block overflow-hidden rounded-xl border border-white/10 bg-[#101010] transition duration-300 hover:-translate-y-0.5 hover:border-[#d6a84a]/50"
                    >
                      <motion.div
                        layoutId={`game-card-${game.slug}`}
                        whileTap={{
                          scale: 0.965,
                          y: 1,
                        }}
                        transition={{
                          layout: {
                            duration: 0.52,
                            ease: [0.22, 1, 0.36, 1],
                          },
                          scale: {
                            duration: 0.16,
                            ease: [0.22, 1, 0.36, 1],
                          },
                        }}
                      >
                        <motion.div
                          layoutId={`game-image-${game.slug}`}
                          className="w-full overflow-hidden bg-white/[0.03]"
                        >
                          <motion.img
                            src={game.imageUrl ?? undefined}
                            alt={game.name}
                            className="block h-auto w-full"
                            whileHover={{
                              scale: 1.05,
                            }}
                            transition={{
                              duration: 0.45,
                              ease: [0.22, 1, 0.36, 1],
                            }}
                          />
                        </motion.div>

                        <motion.div
                          layoutId={`game-content-${game.slug}`}
                          className="px-3 py-2.5"
                        >
                          <h3 className="truncate text-sm font-bold text-white transition-colors duration-300 group-hover:text-[#d6a84a]">
                            {game.name}
                          </h3>

                          <p className="mt-1 text-[10px] text-white/40">
                            {catalogTab === "topup"
                              ? "Top Up Game"
                              : catalogTab === "voucher"
                                ? "Voucher"
                                : "App Premium"}
                          </p>
                        </motion.div>
                      </motion.div>
                    </Link>
                  </motion.div>
                ))}
              </div>

              {catalogGames.length > 12 && (
                <div className="mt-6 flex flex-col items-center gap-3">
                  <button
                    type="button"
                    onClick={handleShowMore}
                    className="w-auto min-w-[220px] rounded-lg border border-[#d6a84a]/70 bg-[#d6a84a]/10 px-5 py-2.5 text-center text-sm font-semibold text-[#f3c968] shadow-[0_0_18px_rgba(214,168,74,0.10)] transition hover:border-[#d6a84a] hover:bg-[#d6a84a]/20 hover:text-[#ffe29a] active:scale-[0.98]"
                  >
                    {visibleCount < games.length
                      ? "Tampilkan Lainnya..."
                      : "Semua Produk Tampil"}
                  </button>

                    {visibleCount > 12 && (
                      <button
                        type="button"
                        onClick={handleShowLess}
                        className="w-auto min-w-[220px] rounded-lg border border-white/20 bg-white/[0.07] px-5 py-2.5 text-center text-sm font-semibold text-white/90 shadow-[0_0_12px_rgba(255,255,255,0.04)] transition hover:border-white/35 hover:bg-white/[0.11] hover:text-white active:scale-[0.98]"
                      >
                        Tampilkan Lebih Sedikit
                      </button>
                    )}
                </div>
              )}
            </>
          ) : (
            <div className="rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-12 text-center">
              <Gamepad2 className="mx-auto h-10 w-10 text-white/20" />

              <p className="mt-4 text-sm font-semibold text-white/60">
                Belum ada game untuk kategori ini.
              </p>

              <p className="mt-1 text-xs text-white/35">
                Game akan muncul setelah produk kategorinya tersedia.
              </p>
            </div>
          );
        })()}

      </section>

      {/* =========================================================
          WHY FAIN STORE
      ========================================================= */}
      


      {/* =========================================================
          CTA
      ========================================================= */}
      


      {/* =========================================================
          FOOTER
      ========================================================= */}
      


    
          <Footer />

</main>
<MobileBottomNav />
    </>
  );
}
