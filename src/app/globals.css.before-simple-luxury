/* =========================================================
   FAIN STORE — BLACK + GOLD LUXURY v2
   Premium charcoal + visible but soft gold atmosphere.
   ONLY background/theme. Layout tetap.
   ========================================================= */

html {
  background: #080808 !important;
}

body {
  background-color: #080808 !important;

  background-image:
    /* GOLD LIGHT — bagian atas */
    radial-gradient(
      ellipse 90% 42% at 50% -5%,
      rgba(230, 184, 76, 0.18) 0%,
      rgba(214, 168, 74, 0.10) 25%,
      rgba(214, 168, 74, 0.035) 48%,
      transparent 72%
    ),

    /* GOLD LIGHT — kiri bawah */
    radial-gradient(
      ellipse 55% 40% at -5% 70%,
      rgba(214, 168, 74, 0.075) 0%,
      rgba(214, 168, 74, 0.025) 38%,
      transparent 72%
    ),

    /* GOLD LIGHT — kanan tengah */
    radial-gradient(
      ellipse 55% 42% at 105% 48%,
      rgba(214, 168, 74, 0.065) 0%,
      rgba(214, 168, 74, 0.02) 40%,
      transparent 72%
    ),

    /* CHARCOAL PREMIUM BASE */
    linear-gradient(
      180deg,
      #151515 0%,
      #101010 28%,
      #0b0b0b 58%,
      #080808 100%
    ) !important;

  background-attachment: fixed !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;
}

/* Ambient gold glow tanpa mengganggu konten */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -1;

  background:
    radial-gradient(
      ellipse 70% 20% at 50% 0%,
      rgba(255, 205, 90, 0.055),
      transparent 75%
    );

  opacity: 1;
}

/* Premium vignette */
body::after {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -1;

  background: radial-gradient(
    ellipse at center,
    transparent 35%,
    rgba(0, 0, 0, 0.22) 100%
  );
}
