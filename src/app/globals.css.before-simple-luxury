@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  color-scheme: dark;

  --fain-bg: #0d0a06;
  --fain-bg-2: #151008;
  --fain-surface: #1b140a;
  --fain-surface-2: #241b0d;

  --fain-gold: #d6a84a;
  --fain-gold-light: #f3d58a;
  --fain-gold-dark: #9b6d24;

  --fain-text: #f7ecd5;
  --fain-text-muted: #b9aa8d;

  --fain-border: rgba(214, 168, 74, 0.20);
}

html,
body {
  margin: 0;
  padding: 0;
  min-height: 100%;
}

body {
  background:
    radial-gradient(
      circle at 12% 0%,
      rgba(214, 168, 74, 0.12),
      transparent 28%
    ),
    radial-gradient(
      circle at 88% 18%,
      rgba(155, 109, 36, 0.10),
      transparent 30%
    ),
    linear-gradient(
      135deg,
      var(--fain-bg) 0%,
      var(--fain-bg-2) 48%,
      #090704 100%
    );

  background-attachment: fixed;
  color: var(--fain-text);

  font-feature-settings: "cv11";
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

::selection {
  background-color: var(--fain-gold);
  color: #120d05;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  max-width: 100%;
}

/* FAIN STORE premium surfaces */
@layer components {
  .fain-surface {
    background:
      linear-gradient(
        145deg,
        rgba(36, 27, 13, 0.92),
        rgba(18, 13, 7, 0.96)
      );
    border: 1px solid var(--fain-border);
    box-shadow:
      0 10px 35px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(243, 213, 138, 0.035);
  }

  .fain-gold-button {
    background: linear-gradient(
      135deg,
      var(--fain-gold-light),
      var(--fain-gold)
    );
    color: #171006;
    border: 1px solid rgba(243, 213, 138, 0.45);
    box-shadow: 0 6px 22px rgba(214, 168, 74, 0.18);
  }

  .fain-gold-button:hover {
    background: linear-gradient(
      135deg,
      #f7df9e,
      var(--fain-gold-light)
    );
  }
}

/* Mengurangi kesan hitam polos pada section */
main {
  background:
    radial-gradient(
      ellipse at 50% 0%,
      rgba(214, 168, 74, 0.055),
      transparent 42%
    );
}

/* Scrollbar */
.scrollbar-none::-webkit-scrollbar {
  display: none;
}

.scrollbar-none {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* =========================================================
   FAIN STORE — HOME RETURN TRANSITION
   Dipakai ketika kembali dari halaman lain ke Homepage.
   ========================================================= */

.fain-home-return-transition {
  position: fixed;
  inset: 0;
  z-index: 999999;
  pointer-events: none;
  background:
    radial-gradient(
      circle at 50% 45%,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.025) 22%,
      rgba(0, 0, 0, 0.72) 72%,
      rgba(0, 0, 0, 0.92) 100%
    );
  animation: fainHomeReturn 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  will-change: opacity;
}

.fain-home-return-glow {
  position: absolute;
  inset: 0;
  opacity: 0;
  background:
    radial-gradient(
      ellipse at center,
      rgba(255, 255, 255, 0.16) 0%,
      rgba(255, 255, 255, 0.04) 30%,
      transparent 65%
    );
  animation: fainHomeGlow 520ms ease-out forwards;
}

@keyframes fainHomeReturn {
  0% {
    opacity: 0.92;
  }

  35% {
    opacity: 0.62;
  }

  70% {
    opacity: 0.24;
  }

  100% {
    opacity: 0;
  }
}

@keyframes fainHomeGlow {
  0% {
    opacity: 0;
    transform: scale(0.94);
  }

  35% {
    opacity: 1;
    transform: scale(1);
  }

  100% {
    opacity: 0;
    transform: scale(1.04);
  }
}

@media (prefers-reduced-motion: reduce) {
  .fain-home-return-transition,
  .fain-home-return-glow {
    animation-duration: 1ms;
  }
}

/* =========================================================
   FAIN STORE — HOMEPAGE ENTER TRANSITION
   ========================================================= */

.fain-home-enter {
  animation: fainHomePageEnter 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.fain-home-hero-enter {
  animation: fainHomeHeroEnter 520ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.fain-home-popular-enter {
  animation: fainHomePopularEnter 440ms cubic-bezier(0.16, 1, 0.3, 1) 70ms both;
}

.fain-home-catalog-enter {
  animation: fainHomeCatalogEnter 460ms cubic-bezier(0.16, 1, 0.3, 1) 130ms both;
}

.fain-home-section-enter {
  animation: fainHomeSectionEnter 500ms cubic-bezier(0.16, 1, 0.3, 1) 190ms both;
}

@keyframes fainHomePageEnter {
  from {
    opacity: 0.72;
  }

  to {
    opacity: 1;
  }
}

@keyframes fainHomeHeroEnter {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.985);
    filter: blur(3px);
  }

  55% {
    opacity: 1;
    filter: blur(0);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
}

@keyframes fainHomePopularEnter {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fainHomeCatalogEnter {
  from {
    opacity: 0;
    transform: translateY(20px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fainHomeSectionEnter {
  from {
    opacity: 0;
    transform: translateY(22px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .fain-home-enter,
  .fain-home-hero-enter,
  .fain-home-popular-enter,
  .fain-home-catalog-enter,
  .fain-home-section-enter {
    animation: none !important;
  }
}





