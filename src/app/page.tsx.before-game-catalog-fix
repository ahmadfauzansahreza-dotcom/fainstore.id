"use client";
import HeroBannerCarousel from "@/components/HeroBannerCarousel";

import { useEffect, useState } from "react";
import Link from "next/link";
import {
  ArrowRight,
  ChevronRight,
  Gamepad2,
  ShieldCheck,
  Zap,
  CreditCard,
  Search,
  Sparkles,
  ShoppingCart,
} from "lucide-react";

interface Product {
  id: string;
  slug: string;
  name: string;
  priceIdr: number;
  originalPriceIdr?: number | null;
  discountPct?: number | null;
  stockQty: number;
  soldCount: number;
  images?: {
    url: string;
  }[];
  game?: {
    name: string;
    slug: string;
  };
  category?: {
    id?: string;
    name: string;
    slug: string;
  } | null;
  type?: "GAME_ACCOUNT" | "TOPUP";
}

interface Game {
  id?: string;
  name: string;
  slug: string;
  imageUrl?: string | null;
  isActive?: boolean;
}

const formatRupiah = (value: number) =>
  new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0,
  }).format(value);

export default function HomePage() {
  const [products, setProducts] = useState<Product[]>([]);
  const [games, setGames] = useState<Game[]>([]);
  const [loading, setLoading] = useState(true);
  const [selectedProductCategory, setSelectedProductCategory] = useState<"TOPUP" | "VOUCHER" | "LIVE_APP">("TOPUP");
  const [showAllGames, setShowAllGames] = useState(false);
  const [catalogTab, setCatalogTab] = useState<"topup" | "voucher" | "live">("topup");


  useEffect(() => {
    const loadData = async () => {
      try {
        const res = await fetch("/api/products?pageSize=100", {
          cache: "no-store",
        });

        if (!res.ok) {
          throw new Error("Gagal mengambil produk");
        }

        const data = await res.json();

        const items: Product[] = data.items ?? [];

        setProducts(items);

        const uniqueGames = Array.from(
          new Map(
            items
              .filter((item) => item.game)
              .map((item) => [
                item.game!.slug,
                {
                  name: item.game!.name,
                  slug: item.game!.slug,
                },
              ])
          ).values()
        );

        setGames(uniqueGames);
      fetch("/api/games").then((r) => r.json()).then((d) => setGames(d.items ?? [])).catch(console.error);
      } catch (error) {
        console.error("Homepage error:", error);
      } finally {
        setLoading(false);
      }
    };

    loadData();
  }, []);


  const popularGames = Array.from(
    products
      .filter((product) => product.game)
      .reduce((map, product) => {
        const game = product.game!;

        const existing = map.get(game.slug);

        if (!existing || product.soldCount > existing.soldCount) {
          map.set(game.slug, {
            name: game.name,
            slug: game.slug,
            image: product.images?.[0]?.url || "/placeholder-product.jpg",
            soldCount: product.soldCount || 0,
          });
        }

        return map;
      }, new Map<string, {
        name: string;
        slug: string;
        image: string;
        soldCount: number;
      }>())
      .values()
  ).sort((a, b) => b.soldCount - a.soldCount).slice(0, 6);

  return (
    <main className="min-h-screen bg-[#050505] text-white">

      {/* =========================================================
          HERO
      ========================================================= */}
        {/* HERO BANNER */}
        {/* =========================================================
            HERO BANNER CAROUSEL
        ========================================================= */}
        <section className="relative border-b border-white/10">
          <div className="mx-auto max-w-7xl px-4 pt-4 pb-6 sm:px-6 lg:px-8">
            <div className="relative block w-full">
              <div className="relative overflow-hidden rounded-3xl border border-white/10 bg-black shadow-2xl">
                <HeroBannerCarousel />
              </div>
            </div>
          </div>
        </section>

        {/* =========================================================
          POPULAR GAMES — ITSUGAMARKET STYLE
        ========================================================= */}
        <section className="mx-auto max-w-7xl px-4 pt-8 pb-10 sm:px-6 lg:px-8">
          <div className="mb-5">
            <div className="flex items-center gap-2">
              <span className="text-xl">🔥</span>
              <h2 className="text-xl font-black sm:text-2xl">
                POPULER SEKARANG!
              </h2>
            </div>

            <p className="mt-2 text-xs text-white/50 sm:text-sm">
              Berikut adalah beberapa game yang paling populer saat ini.
            </p>
          </div>

          {(() => {
            const popularSlugs = [
              "mobile-legends",
              "free-fire",
              "pubg-mobile",
              "genshin-impact",
              "valorant",
              "call-of-duty-mobile",
              "ragnarok-origin",
              "arena-of-valor",
            ];

            const popularGames = popularSlugs
              .map((slug) => games.find((game) => game.slug === slug))
              .filter((game): game is Game => Boolean(game));

            return popularGames.length > 0 ? (
              <div className="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-3">
                {popularGames.map((game) => {
                  const gameImage = game.imageUrl || "";

                  return (
                    <Link
                      key={game.slug}
                      href={`/game/${game.slug}`}
                      className="group flex min-h-[76px] items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.025] px-3 py-3 transition duration-300 hover:border-blue-500/40 hover:bg-blue-500/[0.05]"
                    >
                      <div className="h-12 w-12 shrink-0 overflow-hidden rounded-xl border border-white/10 bg-white/[0.04]">
                        {gameImage ? (
                          <img
                            src={gameImage}
                            alt={game.name}
                            className="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                          />
                        ) : (
                          <div className="flex h-full w-full items-center justify-center bg-white/[0.04]">
                            <Gamepad2 className="h-6 w-6 text-white/30" />
                          </div>
                        )}
                      </div>

                      <div className="min-w-0">
                        <p className="truncate text-xs font-bold text-white group-hover:text-blue-400">
                          {game.name}
                        </p>

                        <p className="mt-1 text-[9px] text-white/40">
                          FAIN STORE
                        </p>
                      </div>
                    </Link>
                  );
                })}
              </div>
            ) : (
              <div className="rounded-2xl border border-white/10 bg-white/[0.03] p-8 text-center text-sm text-white/50">
                Game populer belum tersedia.
              </div>
            );
          })()}
        </section>



      {/* =========================================================
          GAME CATALOG — ITSUGAMARKET STYLE
      ========================================================= */}
      {(() => {
        const getTab = (product: Product) => {
          const categoryName = product.category?.name?.toLowerCase() || "";
          const categorySlug = product.category?.slug?.toLowerCase() || "";

          if (
            categoryName.includes("voucher") ||
            categorySlug.includes("voucher")
          ) {
            return "voucher";
          }

          if (
            categoryName.includes("live") ||
            categoryName.includes("app") ||
            categorySlug.includes("live") ||
            categorySlug.includes("app")
          ) {
            return "live";
          }

          if (
            product.type === "TOPUP" ||
            categoryName.includes("top up") ||
            categoryName.includes("topup") ||
            categorySlug.includes("top-up") ||
            categorySlug.includes("topup")
          ) {
            return "topup";
          }

          return null;
        };

        const tabProducts = products.filter(
          (product) => getTab(product) === catalogTab
        );

        const catalogGames = Array.from(
          new Map(
            tabProducts
              .filter((product) => product.game)
              .map((product) => {
                const game = product.game!;
                const gameData = games.find(
                  (item) => item.slug === game.slug
                );

                return [
                  game.slug,
                  {
                    slug: game.slug,
                    name: game.name,
                    imageUrl:
                      gameData?.imageUrl ||
                      product.images?.[0]?.url ||
                      "/placeholder-product.jpg",
                  },
                ];
              })
          ).values()
        );

        const visibleGames = showAllGames
          ? catalogGames
          : catalogGames.slice(0, 9);

        return (
          <section className="mx-auto max-w-7xl px-4 pt-2 pb-10 sm:px-6 lg:px-8">
            <div className="mb-5">
              <div className="flex items-center gap-2">
                <span className="text-xl">🎮</span>
                <h2 className="text-xl font-black sm:text-2xl">
                  PILIH GAME
                </h2>
              </div>

              <p className="mt-2 text-xs text-white/50 sm:text-sm">
                Pilih layanan game yang ingin kamu gunakan.
              </p>
            </div>

            {/* CATEGORY TABS */}
            <div className="mb-6 grid grid-cols-3 gap-2">
              {[
                { id: "topup", label: "Top Up" },
                { id: "voucher", label: "Voucher" },
                { id: "live", label: "Live App" },
              ].map((tab) => {
                const active = catalogTab === tab.id;

                return (
                  <button
                    key={tab.id}
                    type="button"
                    onClick={() => {
                      setCatalogTab(
                        tab.id as "topup" | "voucher" | "live"
                      );
                      setShowAllGames(false);
                    }}
                    className={[
                      "h-11 rounded-xl border text-sm font-bold transition",
                      active
                        ? "border-blue-500 bg-blue-500 text-white"
                        : "border-white/10 bg-white/[0.04] text-white/60 hover:border-white/20 hover:text-white",
                    ].join(" ")}
                  >
                    {tab.label}
                  </button>
                );
              })}
            </div>

            {visibleGames.length > 0 ? (
              <>
                <div className="grid grid-cols-2 gap-3 sm:grid-cols-3">
                  {visibleGames.map((game) => (
                    <Link
                      key={game.slug}
                      href={`/game/${game.slug}`}
                      className="group overflow-hidden rounded-2xl border border-white/10 bg-[#101010] transition duration-300 hover:border-blue-500/50"
                    >
                      <div className="aspect-[4/3] overflow-hidden bg-white/[0.03]">
                        <img
                          src={game.imageUrl}
                          alt={game.name}
                          className="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                        />
                      </div>

                      <div className="px-3 py-3">
                        <h3 className="truncate text-sm font-bold text-white group-hover:text-blue-400">
                          {game.name}
                        </h3>

                        <p className="mt-1 text-[10px] text-white/40">
                          {catalogTab === "topup"
                            ? "Top Up Game"
                            : catalogTab === "voucher"
                              ? "Voucher"
                              : "Live App"}
                        </p>
                      </div>
                    </Link>
                  ))}
                </div>

                {catalogGames.length > 9 && (
                  <div className="mt-6 flex justify-center">
                    <button
                      type="button"
                      onClick={() => setShowAllGames((value) => !value)}
                      className="rounded-xl border border-white/15 bg-white/[0.04] px-6 py-3 text-sm font-semibold text-white transition hover:border-blue-500/50 hover:bg-blue-500/10"
                    >
                      {showAllGames
                        ? "Tampilkan Lebih Sedikit"
                        : "Tampilkan Lainnya..."}
                    </button>
                  </div>
                )}
              </>
            ) : (
              <div className="rounded-2xl border border-white/10 bg-white/[0.03] p-8 text-center">
                <p className="text-sm font-semibold text-white/70">
                  Belum ada produk untuk kategori ini.
                </p>

                <p className="mt-1 text-xs text-white/40">
                  Produk akan muncul setelah tersedia di katalog.
                </p>
              </div>
            )}
          </section>
        );
      })()}

      {/* =========================================================
          PILIH GAME — TOP UP / VOUCHER / LIVE APP
      ========================================================= */}
      <section className="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
        <div className="mb-5">
          <div className="flex items-center gap-2">
            <span className="text-xl">🎮</span>
            <h2 className="text-xl font-black sm:text-2xl">
              PILIH GAME
            </h2>
          </div>

          <p className="mt-2 text-xs text-white/50 sm:text-sm">
            Pilih layanan game yang ingin kamu gunakan.
          </p>
        </div>

        {(() => {
          const categoryMatchers = {
            TOPUP: (categoryName: string, categorySlug: string) =>
              categoryName.toLowerCase().includes("top up") ||
              categoryName.toLowerCase().includes("topup") ||
              categorySlug.includes("top-up") ||
              categorySlug.includes("topup"),

            VOUCHER: (categoryName: string, categorySlug: string) =>
              categoryName.toLowerCase().includes("voucher") ||
              categorySlug.includes("voucher"),

            LIVE_APP: (categoryName: string, categorySlug: string) =>
              categoryName.toLowerCase().includes("service") ||
              categoryName.toLowerCase().includes("live") ||
              categoryName.toLowerCase().includes("app") ||
              categorySlug.includes("service") ||
              categorySlug.includes("live-app") ||
              categorySlug.includes("live"),
          };

          const matcher = categoryMatchers[selectedProductCategory];

          const filteredProducts = products.filter((product) => {
            if (!product.game || !product.category) return false;

            return matcher(
              product.category.name,
              product.category.slug
            );
          });

          const gameMap = new Map<
            string,
            {
              name: string;
              slug: string;
              image: string;
            }
          >();

          filteredProducts.forEach((product) => {
            if (!product.game) return;

            const slug = product.game.slug;

            if (!gameMap.has(slug)) {
              gameMap.set(slug, {
                name: product.game.name,
                slug,
                image:
                  product.images?.[0]?.url ||
                  "/placeholder-product.jpg",
              });
            }
          });

          const gamesForCategory = Array.from(gameMap.values());

          const visibleGames = showAllGames
            ? gamesForCategory
            : gamesForCategory.slice(0, 6);

          return (
            <>
              <div className="mb-5 grid grid-cols-3 gap-2 sm:gap-3">
                {[
                  ["TOPUP", "Top Up"],
                  ["VOUCHER", "Voucher"],
                  ["LIVE_APP", "Live App"],
                ].map(([value, label]) => {
                  const active =
                    selectedProductCategory === value;

                  return (
                    <button
                      key={value}
                      type="button"
                      onClick={() => {
                        setSelectedProductCategory(
                          value as "TOPUP" | "VOUCHER" | "LIVE_APP"
                        );
                        setShowAllGames(false);
                      }}
                      className={`rounded-xl border px-3 py-3 text-xs font-bold transition sm:rounded-2xl sm:py-3.5 sm:text-sm ${
                        active
                          ? "border-blue-500 bg-blue-500 text-white shadow-lg shadow-blue-500/20"
                          : "border-white/10 bg-white/[0.025] text-white/70 hover:border-white/20 hover:bg-white/[0.05]"
                      }`}
                    >
                      {label}
                    </button>
                  );
                })}
              </div>

              {visibleGames.length > 0 ? (
                <>
                  <div className="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-3">
                    {visibleGames.map((game) => (
                      <Link
                        key={game.slug}
                        href={`/game/${game.slug}`}
                        className="group overflow-hidden rounded-2xl border border-white/10 bg-white/[0.025] transition duration-300 hover:border-blue-500/40 hover:bg-blue-500/[0.04]"
                      >
                        <div className="aspect-[3/2] overflow-hidden bg-white/[0.04]">
                          <img
                            src={game.image}
                            alt={game.name}
                            className="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                          />
                        </div>

                        <div className="p-3">
                          <p className="truncate text-xs font-bold text-white sm:text-sm">
                            {game.name}
                          </p>

                          <p className="mt-1 text-[10px] text-white/40 sm:text-xs">
                            {selectedProductCategory === "TOPUP"
                              ? "Top Up Game"
                              : selectedProductCategory === "VOUCHER"
                                ? "Voucher"
                                : "Live App"}
                          </p>
                        </div>
                      </Link>
                    ))}
                  </div>

                  {gamesForCategory.length > 6 && (
                    <div className="mt-5 flex justify-center">
                      <button
                        type="button"
                        onClick={() => setShowAllGames((value) => !value)}
                        className="rounded-xl border border-white/15 bg-white/[0.04] px-5 py-2.5 text-xs font-bold text-white/80 transition hover:border-blue-500/40 hover:bg-blue-500/[0.06] sm:text-sm"
                      >
                        {showAllGames
                          ? "Tampilkan Lebih Sedikit"
                          : "Tampilkan Lainnya..."}
                      </button>
                    </div>
                  )}
                </>
              ) : (
                <div className="rounded-2xl border border-white/10 bg-white/[0.025] px-5 py-10 text-center">
                  <p className="text-sm font-bold text-white/70">
                    Belum ada produk untuk kategori ini.
                  </p>

                  <p className="mt-1 text-xs text-white/40">
                    Produk akan muncul setelah tersedia di katalog.
                  </p>
                </div>
              )}
            </>
          );
        })()}
      </section>

      {/* =========================================================
          WHY FAIN STORE
      ========================================================= */}
      <section className="border-y border-white/10 bg-white/[0.015]">

        <div className="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">

          <div className="rounded-3xl border border-white/10 bg-gradient-to-br from-blue-600/[0.12] to-transparent p-6 sm:p-10">

            <div className="max-w-2xl">

              <span className="text-xs font-bold uppercase tracking-widest text-blue-400">
                Kenapa FAIN STORE?
              </span>

              <h2 className="mt-3 text-2xl font-black sm:text-3xl">
                Belanja kebutuhan game tanpa ribet.
              </h2>

              <p className="mt-3 text-sm leading-6 text-white/50">
                Kami membuat proses pembelian menjadi sederhana,
                mulai dari memilih produk sampai pembayaran.
              </p>

            </div>


            <div className="mt-8 grid gap-4 sm:grid-cols-3">

              <div className="rounded-2xl border border-white/10 bg-black/20 p-5">

                <Zap className="h-6 w-6 text-blue-400" />

                <h3 className="mt-4 font-bold">
                  Proses Cepat
                </h3>

                <p className="mt-2 text-xs leading-5 text-white/40">
                  Pesanan diproses secepat mungkin setelah pembayaran.
                </p>

              </div>


              <div className="rounded-2xl border border-white/10 bg-black/20 p-5">

                <ShieldCheck className="h-6 w-6 text-blue-400" />

                <h3 className="mt-4 font-bold">
                  Transaksi Aman
                </h3>

                <p className="mt-2 text-xs leading-5 text-white/40">
                  Sistem dirancang agar proses transaksi lebih aman
                  dan jelas.
                </p>

              </div>


              <div className="rounded-2xl border border-white/10 bg-black/20 p-5">

                <CreditCard className="h-6 w-6 text-blue-400" />

                <h3 className="mt-4 font-bold">
                  Pembayaran Praktis
                </h3>

                <p className="mt-2 text-xs leading-5 text-white/40">
                  Mendukung alur pembayaran otomatis yang akan
                  kita integrasikan.
                </p>

              </div>

            </div>

          </div>

        </div>

      </section>


      {/* =========================================================
          CTA
      ========================================================= */}
      <section className="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">

        <div className="overflow-hidden rounded-3xl border border-blue-500/20 bg-blue-600 p-7 text-center sm:p-10">

          <h2 className="text-2xl font-black sm:text-3xl">
            Siap belanja?
          </h2>

          <p className="mx-auto mt-3 max-w-lg text-sm text-blue-100/80">
            Pilih game, pilih produk, dan lanjutkan transaksi
            di FAIN STORE.
          </p>

          <Link
            href="/produk"
            className="mt-6 inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-black text-blue-600 transition hover:bg-blue-50"
          >
            Lihat Produk
            <ArrowRight className="h-4 w-4" />
          </Link>

        </div>

      </section>


      {/* =========================================================
          FOOTER
      ========================================================= */}
      <footer className="border-t border-white/10 bg-[#030303]">

        <div className="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">

          <div className="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">

            <div>

              <h3 className="text-lg font-black">
                FAIN <span className="text-blue-500">STORE</span>
              </h3>

              <p className="mt-3 max-w-xs text-xs leading-6 text-white/40">
                Marketplace game dan produk digital untuk kebutuhan
                gaming kamu.
              </p>

            </div>


            <div>

              <h4 className="text-sm font-bold">
                Navigasi
              </h4>

              <div className="mt-4 flex flex-col gap-3 text-xs text-white/50">

                <Link
                  href="/"
                  className="transition hover:text-white"
                >
                  Beranda
                </Link>

                <Link
                  href="/produk"
                  className="transition hover:text-white"
                >
                  Produk
                </Link>

                <Link
                  href="/top-up"
                  className="transition hover:text-white"
                >
                  Top Up
                </Link>

                <Link
                  href="/faq"
                  className="transition hover:text-white"
                >
                  FAQ
                </Link>

              </div>

            </div>


            <div>

              <h4 className="text-sm font-bold">
                Bantuan
              </h4>

              <div className="mt-4 flex flex-col gap-3 text-xs text-white/50">

                <Link
                  href="/contact"
                  className="transition hover:text-white"
                >
                  Hubungi Kami
                </Link>

                <Link
                  href="/privacy"
                  className="transition hover:text-white"
                >
                  Kebijakan Privasi
                </Link>

                <Link
                  href="/refund-policy"
                  className="transition hover:text-white"
                >
                  Kebijakan Refund
                </Link>

              </div>

            </div>


            <div>

              <h4 className="text-sm font-bold">
                FAIN STORE
              </h4>

              <p className="mt-4 text-xs leading-6 text-white/40">
                Belanja game dengan proses yang sederhana,
                cepat, dan praktis.
              </p>

            </div>

          </div>


          <div className="mt-10 border-t border-white/10 pt-6">

            <p className="text-center text-[10px] text-white/30 sm:text-xs">
              © {new Date().getFullYear()} FAIN STORE. All rights reserved.
            </p>

          </div>

        </div>

      </footer>


      {/* =========================================================
          MOBILE FLOATING SEARCH
      ========================================================= */}
      <Link
        href="/produk"
        className="fixed bottom-20 right-4 z-40 flex h-12 w-12 items-center justify-center rounded-full border border-blue-400/30 bg-blue-600 text-white shadow-xl shadow-blue-900/30 sm:hidden"
        aria-label="Cari produk"
      >
        <Search className="h-5 w-5" />
      </Link>

    </main>
  );
}
